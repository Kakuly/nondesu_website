---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Sticker from "../../components/ui/Sticker.astro";
import { getCollection } from "astro:content";

const events = (await getCollection("events")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const goods = await getCollection("goods");
const upcomingEvents = events.filter((event) => event.data.status === "upcoming");
---

<BaseLayout
  title="苺茶かのん"
  description="VTuber 苺茶かのん（いちやかのん）の配信・イベント・グッズ情報"
  theme="ichiyakanon"
  current="home"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <span class="hero-badge">♡ いちやかのん</span>
      <h1>苺茶かのんの<br />お部屋。</h1>
      <p class="hero-lede">
        のんですの VTuber 名義。配信・イベント・グッズの案内を、
        苺色の別世界観でまとめています。
      </p>
    </div>
  </section>

  <section class="section" id="streams">
    <div class="wrap">
      <h2 class="section-title">配信</h2>
      <p class="section-lede">最新の配信予定やアーカイブはここから。</p>
      <Card kicker="stream">
        <h3>次回配信</h3>
        <p>YouTube での雑談・歌枠など。スケジュールは X で告知します。</p>
        <p><a href="https://youtube.com/@nondesu" target="_blank" rel="noreferrer">YouTube チャンネル →</a></p>
      </Card>
    </div>
  </section>

  <section class="section" id="events">
    <div class="wrap">
      <h2 class="section-title">イベント</h2>
      <div class="event-list">
        {
          upcomingEvents.map((event) => (
            <Card>
              <Sticker label="upcoming" tone="lavender" />
              <h3>{event.data.title}</h3>
              <p>
                {event.data.date.toLocaleDateString("ja-JP")}
                {event.data.venue ? ` / ${event.data.venue}` : ""}
              </p>
              {event.data.url && (
                <p>
                  <a href={event.data.url} target="_blank" rel="noreferrer">詳細 →</a>
                </p>
              )}
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="goods">
    <div class="wrap">
      <h2 class="section-title">グッズ</h2>
      <div class="goods-grid">
        {
          goods.map((item) => (
            <Card>
              <div class="work-card-cover">
                {item.data.image ? (
                  <img src={item.data.image} alt="" loading="lazy" />
                ) : (
                  <span>🍓</span>
                )}
              </div>
              <h3>{item.data.title}</h3>
              {item.data.price && <p>{item.data.price}</p>}
              {item.data.url && (
                <p>
                  <a href={item.data.url} target="_blank" rel="noreferrer">購入ページ →</a>
                </p>
              )}
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
