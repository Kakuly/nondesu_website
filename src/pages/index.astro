---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout current="home" description="のんです official site">
  <section class="hero-splash" aria-label="トップ">
    <div class="hero-splash-deco" aria-hidden="true">
      <span class="hero-splash-blob hero-splash-blob--1"></span>
      <span class="hero-splash-blob hero-splash-blob--2"></span>
      <span class="hero-splash-blob hero-splash-blob--3"></span>
      <span class="hero-splash-sticker">♡</span>
    </div>
    <h1 class="hero-splash-title">
      <span class="hero-splash-line">のんです</span>
      <span class="hero-splash-line hero-splash-line-accent">official site!</span>
    </h1>
  </section>
</BaseLayout>
