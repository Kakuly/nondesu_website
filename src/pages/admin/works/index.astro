---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="作品一覧">
  <section class="admin-card">
    <h2 class="admin-card-title">作品一覧</h2>
    <p class="admin-hint"><code>src/content/works/*.yaml</code> を編集します。</p>
    <p id="works-loading" class="admin-loading">読み込み中…</p>
    <ul id="works-list" class="admin-work-list" hidden></ul>
    <p id="works-status" class="admin-status" role="status"></p>
    <div class="admin-actions">
      <a class="admin-btn admin-btn-secondary" href="/admin/">戻る</a>
    </div>
  </section>
</AdminLayout>

<script>
  import { apiJson, requireSession, showStatus } from "../../../scripts/admin/client";

  interface WorkSummary {
    slug: string;
    title: string;
    category: string;
    featured: boolean;
    date: string;
  }

  const loading = document.getElementById("works-loading");
  const list = document.getElementById("works-list");
  const status = document.getElementById("works-status");

  async function loadWorks() {
    await requireSession();
    const result = await apiJson<{ works: WorkSummary[] }>("/api/admin/content/works");

    if (!list) return;
    list.innerHTML = result.works
      .map(
        (work) => `
          <li class="admin-work-item">
            <a href="/admin/works/edit/?slug=${work.slug}">
              <span>${work.title}</span>
              <span class="admin-work-meta">${work.category}${work.featured ? " · featured" : ""}</span>
            </a>
          </li>
        `,
      )
      .join("");

    if (loading) loading.hidden = true;
    list.hidden = false;
  }

  loadWorks().catch((error) => {
    showStatus(status, error instanceof Error ? error.message : "読み込みに失敗しました。", "error");
    if (loading) loading.hidden = true;
  });
</script>
