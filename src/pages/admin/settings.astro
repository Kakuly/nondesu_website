---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="アカウント設定">
  <section class="admin-card">
    <h2 class="admin-card-title">パスワード変更</h2>
    <p class="admin-hint">
      変更すると GitHub の <code>src/content/admin/password-overrides.yaml</code> に保存されます。
      Cloudflare の環境変数（初期パスワード）はそのまま残りますが、上書き後はこちらが優先されます。
    </p>
    <p id="settings-user" class="admin-loading">確認中…</p>

    <form id="password-form" class="admin-grid" hidden>
      <div class="admin-field">
        <label for="current-password">現在のパスワード</label>
        <input
          id="current-password"
          name="currentPassword"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>
      <div class="admin-field">
        <label for="new-password">新しいパスワード</label>
        <input
          id="new-password"
          name="newPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
      <div class="admin-field">
        <label for="confirm-password">新しいパスワード（確認）</label>
        <input
          id="confirm-password"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
      <div class="admin-actions">
        <button type="submit" class="admin-btn admin-btn-primary">変更する</button>
        <a class="admin-btn admin-btn-secondary" href="/admin/">戻る</a>
      </div>
    </form>

    <p id="password-status" class="admin-status" role="status"></p>
  </section>
</AdminLayout>

<script>
  import { apiJson, requireSession, showStatus } from "../../scripts/admin/client";

  const MIN_LENGTH = 8;
  const form = document.getElementById("password-form") as HTMLFormElement | null;
  const userEl = document.getElementById("settings-user");
  const status = document.getElementById("password-status");

  async function init() {
    try {
      const session = await requireSession();
      if (userEl && session.username) {
        userEl.textContent = `${session.username} のパスワードを変更`;
        userEl.className = "";
      }
      form?.removeAttribute("hidden");
    } catch {
      // redirect handled in requireSession
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const currentPassword = String(data.get("currentPassword") ?? "");
    const newPassword = String(data.get("newPassword") ?? "");
    const confirmPassword = String(data.get("confirmPassword") ?? "");

    if (newPassword.length < MIN_LENGTH) {
      showStatus(status, `新しいパスワードは ${MIN_LENGTH} 文字以上にしてください。`, "error");
      return;
    }

    if (newPassword !== confirmPassword) {
      showStatus(status, "確認用パスワードが一致しません。", "error");
      return;
    }

    if (newPassword === currentPassword) {
      showStatus(status, "新しいパスワードは現在のパスワードと異なるものにしてください。", "error");
      return;
    }

    try {
      const result = await apiJson<{ message?: string }>("/api/admin/password", {
        method: "POST",
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      showStatus(status, result.message ?? "パスワードを変更しました。", "success");
      form.reset();
    } catch (error) {
      const message = error instanceof Error ? error.message : "変更に失敗しました。";
      showStatus(status, message, "error");
    }
  });

  init();
</script>
