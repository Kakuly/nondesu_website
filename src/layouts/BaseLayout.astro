---
interface Props {
  title?: string;
  description?: string;
  theme?: "nondesu" | "ichiyakanon";
  current?: "home" | "profile" | "portfolio" | "commissions";
}

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";

const {
  title = "nondesu",
  description = "歌い手・作家・イラストレーター のんです の公式サイト",
  theme = "nondesu",
  current,
} = Astro.props;

const pageTitle = title === "nondesu" ? title : `${title} | nondesu`;
---

<!doctype html>
<html lang="ja" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800&family=Noto+Sans+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header current={current} theme={theme} />
    <main id="main">
      <slot />
    </main>
    <Footer theme={theme} />
  </body>
</html>
