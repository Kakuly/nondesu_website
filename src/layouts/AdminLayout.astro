---
interface Props {
  title?: string;
  showHeader?: boolean;
}

import "../styles/admin.css";

const { title = "おもちゃ箱 admin", showHeader = true } = Astro.props;
const pageTitle = title === "おもちゃ箱 admin" ? title : `${title} | おもちゃ箱 admin`;
---

<!doctype html>
<html lang="ja" data-theme="nondesu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800&family=Noto+Sans+JP:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      showHeader ? (
        <div class="admin-shell">
          <header class="admin-header">
            <div class="admin-brand">
              <div class="admin-logo" aria-hidden="true">
                の
              </div>
              <div>
                <h1 class="admin-title">おもちゃ箱 admin</h1>
                <p class="admin-subtitle">のんですサイトの編集室</p>
              </div>
            </div>
            <button type="button" class="admin-btn admin-btn-ghost" id="admin-logout">
              ログアウト
            </button>
          </header>
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>

<script>
  const logoutBtn = document.getElementById("admin-logout");
  logoutBtn?.addEventListener("click", async () => {
    await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
    window.location.href = "/admin/login/";
  });
</script>
