# Cloudflare Pages → Settings → Environment variables
# Production と Preview の両方に設定すること

# カスタム admin（本番編集）— 2 アカウント
ADMIN_USER_1=nondesu
ADMIN_PASS_1=
ADMIN_USER_2=kakuly
ADMIN_PASS_2=
SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=Kakuly/nondesu_website
GITHUB_BRANCH=main

# 旧 1 アカウント設定（移行完了後は削除可）
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# 依頼フォーム
CONTACT_EMAIL=nondesu0816@gmail.com

# Turnstile（任意）
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# （非推奨）Decap CMS 用 GitHub OAuth — カスタム admin 移行後は不要
